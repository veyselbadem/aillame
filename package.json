{
    "name":  "aillame",
    "version":  "1.3.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev --webpack",
                    "build":  "next build --webpack",
                    "start":  "next start",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "tsc --noEmit",
                    "validate:nano-data":  "node scripts/validate-nano-data.mjs",
                    "diagnostic:nano-tokenizer":  "node scripts/nano-tokenizer-diagnostic.mjs",
                    "smoke:foundation":  "node scripts/aillame-foundation-smoke.mjs",
                    "smoke:project-provider":  "node scripts/smoke-project-provider-api.mjs",
                    "smoke:code-agent":  "node scripts/smoke-code-agent.mjs",
                    "smoke:image-rag-nano":  "node scripts/smoke-image-rag-nano.mjs",
                    "smoke:external-api":  "node scripts/smoke-external-api.mjs",
                    "smoke:productization":  "node scripts/smoke-productization.mjs",
                    "smoke:beta-ui":  "node scripts/smoke-beta-ui.mjs",
                    "smoke:persistent-storage":  "node scripts/smoke-persistent-storage.mjs",
                    "smoke:security-api-keys": "node scripts/smoke-security-api-keys.mjs",
                    "smoke:external-provider-e2e": "node scripts/smoke-external-provider-e2e.mjs",
                    "smoke:openai-compatible-e2e": "node scripts/smoke-openai-compatible-e2e.mjs",
                    "smoke:provider-e2e": "npm run smoke:external-provider-e2e && npm run smoke:openai-compatible-e2e",
                    "smoke:code-agent-patch-workflow": "node scripts/smoke-code-agent-patch-workflow.mjs",
                    "cli:aillame":  "node scripts/aillame-cli.mjs",
                    "core:build":  "napi build --platform --release --cargo-cwd aillame-core",
                    "core:dev":  "napi build --cargo-cwd aillame-core",
                    "core:train":  "npx tsx src/core/engine/supervisor.ts",
                    "core:test":  "npx tsx src/core/engine/test-rust.ts",
                    "dev:turbo":  "next dev",
                    "build:turbo":  "next build",
                    "desktop:dev": "tauri dev",
                    "desktop:build": "tauri build"
                },
    "dependencies":  {
                         "@lingo-reader/epub-parser":  "^0.4.6",
                         "autoprefixer":  "^10.4.14",
                         "idb":  "^7.1.1",
                         "mammoth":  "^1.12.0",
                         "next":  "^16.2.4",
                         "pdfjs-dist":  "^4.2.67",
                         "postcss":  "^8.4.24",
                         "react":  "^19.2.5",
                         "react-dom":  "^19.2.5",
                         "react-icons":  "^5.6.0",
                         "tailwindcss":  "^3.4.1"
                     },
    "devDependencies":  {
                            "@napi-rs/cli":  "^2.18.4",
                            "@types/node":  "20.11.30",
                            "@types/react":  "^19.0.0",
                            "@tauri-apps/api": "^2.0.0",
                            "@tauri-apps/cli": "^2.0.0",
                            "typescript":  "5.4.5"
                        }
}
