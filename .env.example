# Aillame API Configuration Example
PORT=3000

# Chat Pipeline Settings
# Set to true to use real local LLM inference
AILLAME_CHAT_USE_RUNTIME=false
# Internal flag for actual GGUF execution
AILLAME_ENABLE_REAL_INFERENCE=false
# If model fails or inference is off, allow returning mock data
AILLAME_ALLOW_RUNTIME_MOCK_FALLBACK=true

# Runtime Performance
AILLAME_RUNTIME_TIMEOUT_MS=60000
AILLAME_MAX_OUTPUT_TOKENS=512
AILLAME_TEMPERATURE=0.2

# Project Memory Settings
AILLAME_MEMORY_ENABLED=true
AILLAME_MEMORY_DIR=./data/memory
AILLAME_MEMORY_MAX_RECENT_MESSAGES=20
AILLAME_MEMORY_MAX_FACTS=100
AILLAME_MEMORY_MAX_MESSAGE_LENGTH=10000

# GGUF Model Settings (Required if AILLAME_ENABLE_REAL_INFERENCE=true)
# AILLAME_GEMMA_GGUF_FILE=C:\path\to\model.gguf
