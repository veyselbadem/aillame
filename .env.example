# Aillame Local AI Hub environment template.
# Do not put real secrets in this file.

# === Core paths ===
AILLAME_DATA_DIR=.aillame-data
AILLAME_MODEL_ROOT=C:\AillameModels
AILLAME_MODEL_LIBRARY_DIR=./models
AILLAME_MODEL_LIBRARY_ROOT=
AILLAME_MODEL_DOWNLOADS_ENABLED=false
AILLAME_MODEL_DOWNLOAD_MAX_BYTES=0
AILLAME_MODEL_DOWNLOAD_REQUIRE_APPROVAL=true

# === External Provider API / security ===
AILLAME_EXTERNAL_API_BASE_URL=http://localhost:3000
AILLAME_EXTERNAL_API_AUTH_REQUIRED=false
AILLAME_API_AUTH_REQUIRED=false
AILLAME_API_KEY_STORE_DRIVER=file
AILLAME_API_KEY_HASH_SECRET=
AILLAME_ADMIN_TOKEN=
NEXT_PUBLIC_AILLAME_ADMIN_USERNAME=admin
NEXT_PUBLIC_AILLAME_ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Audit / rate limit / production guards ===
AILLAME_AUDIT_LOG_ENABLED=true
AILLAME_AUDIT_STORE_TYPE=file
AILLAME_RATE_LIMIT_ENABLED=true
AILLAME_RATE_LIMIT_MAX_REQUESTS=60
AILLAME_RATE_LIMIT_WINDOW_MS=60000
AILLAME_EXTERNAL_API_RATE_LIMIT_ENABLED=false
AILLAME_EXTERNAL_API_RATE_LIMIT_WINDOW_MS=60000
AILLAME_EXTERNAL_API_RATE_LIMIT_MAX=60

# === Model discovery ===
AILLAME_MODEL_DISCOVERY_ENABLED=true
AILLAME_MODEL_DISCOVERY_OFFLINE_MODE=true
AILLAME_MODEL_WATCHLIST_ENABLED=true
AILLAME_MODEL_DOWNLOADS_ENABLED=false
AILLAME_MODEL_MANAGER_CACHE_TTL_MS=5000

# === LLM runtime / GGUF text runtime ===
AILLAME_GGUF_RUNTIME_ENABLED=false
AILLAME_GGUF_RUNTIME_BINARY=
AILLAME_GGUF_MODEL_DIR=C:\AillameModels\gguf
AILLAME_GGUF_ACTIVE_MODEL=
AILLAME_GGUF_MODEL_PATH=
AILLAME_GGUF_RUNTIME_ARGS=
AILLAME_TEXT_CONTEXT_SIZE=8192
AILLAME_TEXT_MAX_INPUT_CHARS=12000
AILLAME_TEXT_TIMEOUT_MS=60000
AILLAME_TEXT_AUTO_START=false
AILLAME_TEXT_START_ON_APP_BOOT=false
# Compatibility aliases used by the current GGUF worker readiness layer.
AILLAME_GGUF_WORKER_ENABLED=false
AILLAME_GGUF_AUTO_ENABLE=false
AILLAME_GGUF_ALLOW_EXTERNAL=false
AILLAME_GGUF_MAX_MEMORY_GB=8

# Unified internal text runtime keeps compatibility aliases below, but the
# product architecture should be described as LLM/GGUF text runtime.
AILLAME_INTERNAL_TEXT_RUNTIME_ENABLED=true
AILLAME_INTERNAL_TEXT_PROVIDER=gguf
AILLAME_INTERNAL_TEXT_ALLOW_REMOTE_FALLBACK=false
AILLAME_INTERNAL_TEXT_LOCK_TIMEOUT_MS=120000
AILLAME_INTERNAL_TEXT_LOCK_POLICY=single-heavy-model
AILLAME_INTERNAL_TEXT_MODEL_ID=
AILLAME_INTERNAL_TEXT_MODEL_PATH=
AILLAME_INTERNAL_TEXT_MODEL_CONTEXT_SIZE=8192
AILLAME_INTERNAL_TEXT_MODEL_MAX_INPUT_CHARS=12000
AILLAME_INTERNAL_TEXT_MODEL_TIMEOUT_MS=60000
AILLAME_INTERNAL_TEXT_MODEL_AUTO_START=false
AILLAME_INTERNAL_TEXT_MODEL_UNLOAD_IDLE_MS=180000

# === IGM runtime / diffusion worker ===
AILLAME_IGM_RUNTIME_ENABLED=false
AILLAME_IGM_MODEL_DIR=./models/diffusion
AILLAME_IGM_ACTIVE_MODEL=
AILLAME_IGM_OUTPUT_DIR=./.aillame-data/assets/images
AILLAME_IGM_DEVICE=auto
AILLAME_IMAGE_ASSET_STORE_DRIVER=file
AILLAME_IMAGE_GENERATION_FINAL_ACCEPTANCE_REQUIRED=true
AILLAME_LIVE_IMAGE_RUNTIME_REQUIRED=true

# === RAG / document library ===
AILLAME_DOCUMENT_LIBRARY_ENABLED=true
AILLAME_DOCUMENT_MAX_CHARS=100000
AILLAME_DOCUMENT_CHUNK_MAX_CHARS=1000
AILLAME_DOCUMENT_CHUNK_OVERLAP=100
AILLAME_DOCUMENT_HARD_DELETE_ENABLED=false
AILLAME_PERSISTENCE_STORE_TYPE=file
AILLAME_HEALTH_LIVE_BINDING=true

# === Code Agent ===
AILLAME_CODE_AGENT_PATCH_APPLY_ENABLED=false
AILLAME_CODE_AGENT_APPROVAL_REQUIRED=true
AILLAME_CODE_AGENT_VERIFIER_EXECUTION_ENABLED=false

# === Nano evaluation/advisory core ===
AILLAME_NANO_EVAL_ENABLED=true
AILLAME_NANO_TRAINING_EXPORT_ENABLED=false
AILLAME_NANO_CHECKPOINT_COMPARE_ENABLED=false
AILLAME_NANO_AUTONOMOUS_ACTIONS_ENABLED=false

# === Desktop / runtime acceptance ===
AILLAME_DESKTOP_MODE_ENABLED=false
AILLAME_DESKTOP_OFFLINE_MODE=false
AILLAME_LOCAL_SERVER_HOST=127.0.0.1
AILLAME_LOCAL_SERVER_PORT=3000
AILLAME_RUNTIME_ACCEPTANCE_REQUIRED=true
AILLAME_LIVE_TEXT_RUNTIME_REQUIRED=true
AILLAME_FINAL_ACCEPTANCE_LLM_REQUIRED=true
AILLAME_FINAL_ACCEPTANCE_IGM_REQUIRED=true

# === Beta QA ===
AILLAME_BETA_RC_MODE=false
AILLAME_BETA_QA_STRICT=false

# === Deprecated / compatibility-only aliases ===
# These names are retained because older routes and smoke tests still import
# compatibility adapters. They are not required dependencies for Aillame.

# Gemini compatibility provider; leave disabled unless explicitly testing.
GEMINI_API_KEY=
AILLAME_PRO_PROVIDER=auto
AILLAME_GEMINI_ENABLED=false
AILLAME_GEMINI_API_KEY=
AILLAME_GEMINI_MODEL=
AILLAME_GEMINI_TIMEOUT_MS=60000

# Qwen optional AI Lab/evaluation participant.
AILLAME_AI_LAB_QWEN_TIMEOUT_MS=30000
AILLAME_QWEN_ENABLED=false
AILLAME_QWEN_TIMEOUT_MS=90000

# Gemma compatibility alias for GGUF text runtime examples.
AILLAME_GEMMA_ENABLED=false
AILLAME_GEMMA_RUNTIME=gguf
AILLAME_GEMMA_MODEL_ID=
AILLAME_GEMMA_GGUF_REPO=
AILLAME_GEMMA_GGUF_FILE=
AILLAME_GEMMA_AUTO_START=false
AILLAME_GEMMA_START_ON_APP_BOOT=false
AILLAME_GEMMA_SERVER_URL=http://127.0.0.1:8080
AILLAME_GEMMA_TIMEOUT_MS=60000
AILLAME_GEMMA_LLAMA_SERVER_EXE=
AILLAME_GEMMA_MODEL_PATH=
AILLAME_GEMMA_PORT=8080
AILLAME_GEMMA_CONTEXT_SIZE=8192
AILLAME_GEMMA_STARTUP_TIMEOUT_MS=60000
AILLAME_GEMMA_MAX_INPUT_CHARS=12000
AILLAME_GEMMA_MODELS_DIR=

# Ollama compatibility fallback; not required for Local AI Hub acceptance.
AILLAME_OLLAMA_ENABLED=false
AILLAME_OLLAMA_BASE_URL=http://127.0.0.1:11434
AILLAME_OLLAMA_TEXT_MODEL=
AILLAME_OLLAMA_TIMEOUT_MS=60000
AILLAME_FAST_TEXT_PROVIDER=gguf
AILLAME_INTERNAL_TEXT_FALLBACK_PROVIDER=none

# SDXL compatibility alias; use IGM runtime variables above for new config.
AILLAME_SDXL_ENABLED=false

# Legacy external test aliases.
AILLAME_EXTERNAL_API_KEY=
AILLAME_EXTERNAL_PROVIDER_BASE_URL=http://localhost:3000
AILLAME_EXTERNAL_PROVIDER_TEST_API_KEY=

# Misc optional runtime helpers.
AILLAME_PYTHON=
AILLAME_WEB_SEARCH_TIMEOUT_MS=8000
AILLAME_DEFAULT_TEXT_MODEL_ID=
AILLAME_DEFAULT_CODE_MODEL_ID=
