GEMINI_API_KEY=
AILLAME_EXTERNAL_API_KEY=
AILLAME_EXTERNAL_API_BASE_URL=http://localhost:3000

# External API rate limiting (server-side, memory-only).
# Disable for development; enable for production deployments.
AILLAME_EXTERNAL_API_RATE_LIMIT_ENABLED=false
AILLAME_EXTERNAL_API_RATE_LIMIT_WINDOW_MS=60000
AILLAME_EXTERNAL_API_RATE_LIMIT_MAX=60
AILLAME_PRO_PROVIDER=gemini
AILLAME_GEMINI_ENABLED=true
AILLAME_GEMINI_API_KEY=
AILLAME_GEMINI_MODEL=gemini-2.5-flash
AILLAME_GEMINI_TIMEOUT_MS=60000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AILLAME_PYTHON=
# Admin API token (server-side). Required for protected admin endpoints such as
# GET /api/aillame/feedback and GET /api/aillame/feedback/export.
# Use a strong random value and keep it local/private; do not expose publicly.
AILLAME_ADMIN_TOKEN=
NEXT_PUBLIC_AILLAME_ADMIN_USERNAME=admin
NEXT_PUBLIC_AILLAME_ADMIN_PASSWORD=
AILLAME_AI_LAB_QWEN_TIMEOUT_MS=30000

# Qwen3-VL 8B is optional/heavy and is not part of default research flows.
AILLAME_QWEN_ENABLED=false
AILLAME_QWEN_TIMEOUT_MS=90000

# Gemma 4 E4B GGUF is optional. Set true only after llama-server is running.
AILLAME_GEMMA_ENABLED=false
AILLAME_GEMMA_RUNTIME=gguf
AILLAME_GEMMA_MODEL_ID=gemma-4-E4B-it-Q4_K_M.gguf
AILLAME_GEMMA_GGUF_REPO=ggml-org/gemma-4-E4B-it-GGUF
AILLAME_GEMMA_GGUF_FILE=gemma-4-E4B-it-Q4_K_M.gguf
AILLAME_GEMMA_AUTO_START=true
AILLAME_GEMMA_START_ON_APP_BOOT=true
AILLAME_GEMMA_SERVER_URL=http://127.0.0.1:8080
AILLAME_GEMMA_TIMEOUT_MS=60000
AILLAME_GEMMA_LLAMA_SERVER_EXE=C:\aillame-llama\llama-server.exe
AILLAME_GEMMA_MODEL_PATH=C:\aillame-models\gguf\gemma-4-E4B-it-Q4_K_M.gguf
AILLAME_GEMMA_PORT=8080
AILLAME_GEMMA_CONTEXT_SIZE=8192
AILLAME_GEMMA_STARTUP_TIMEOUT_MS=60000
AILLAME_GEMMA_MAX_INPUT_CHARS=12000

# Unified Internal Text Runtime (Phase 1)
AILLAME_INTERNAL_TEXT_RUNTIME_ENABLED=true
AILLAME_INTERNAL_TEXT_PROVIDER=gguf
AILLAME_INTERNAL_TEXT_FALLBACK_PROVIDER=ollama
AILLAME_INTERNAL_TEXT_ALLOW_REMOTE_FALLBACK=false
AILLAME_INTERNAL_TEXT_LOCK_TIMEOUT_MS=120000
AILLAME_INTERNAL_TEXT_LOCK_POLICY=single-heavy-model
AILLAME_INTERNAL_TEXT_MODEL_ID=gemma-4-E4B-it-Q4_K_M.gguf
AILLAME_INTERNAL_TEXT_MODEL_PATH=C:\aillame-models\gguf\gemma-4-E4B-it-Q4_K_M.gguf
AILLAME_INTERNAL_TEXT_MODEL_CONTEXT_SIZE=8192
AILLAME_INTERNAL_TEXT_MODEL_MAX_INPUT_CHARS=12000
AILLAME_INTERNAL_TEXT_MODEL_TIMEOUT_MS=60000
AILLAME_INTERNAL_TEXT_MODEL_AUTO_START=true
AILLAME_INTERNAL_TEXT_MODEL_UNLOAD_IDLE_MS=180000

# SDXL is optional and should only run for image_generation_plan / explicit visual generation.
AILLAME_SDXL_ENABLED=false

# Ollama Configuration (Default Fast Text Provider)
AILLAME_OLLAMA_ENABLED=true
AILLAME_OLLAMA_BASE_URL=http://127.0.0.1:11434
AILLAME_OLLAMA_TEXT_MODEL=gemma:2b
AILLAME_OLLAMA_TIMEOUT_MS=60000
AILLAME_FAST_TEXT_PROVIDER=ollama

# Web Search keeps a short timeout and falls back to safe sample sources on failure.
AILLAME_WEB_SEARCH_TIMEOUT_MS=8000

# === FAZ 2: Model Manager ===
# Default model IDs for text and code modes.
# These override registry defaultForModes when set.
AILLAME_DEFAULT_TEXT_MODEL_ID=internal-text-gemma-gguf
AILLAME_DEFAULT_CODE_MODEL_ID=internal-text-gemma-gguf

# Root directory for all local model files (repo-external, never commit this path's contents).
# Example: C:\AillameModels
AILLAME_MODEL_ROOT=C:\AillameModels

# Model library and Gemma-specific directories (used by preflight/switch helpers).
# Keep these paths outside the repository.
AILLAME_MODEL_LIBRARY_DIR=
AILLAME_MODEL_LIBRARY_ROOT=
AILLAME_GEMMA_MODELS_DIR=

# Root directory for image generation models (SDXL, Flux, etc.) — disabled by default.
AILLAME_IMAGE_MODEL_ROOT=C:\AillameModels\image

# Model Manager status cache TTL in milliseconds.
AILLAME_MODEL_MANAGER_CACHE_TTL_MS=5000

# === FAZ 5: Productization & Security ===
AILLAME_API_AUTH_REQUIRED=false
AILLAME_AUDIT_LOG_ENABLED=true
AILLAME_AUDIT_STORE_TYPE=in-memory
AILLAME_PERSISTENCE_STORE_TYPE=file
AILLAME_DESKTOP_OFFLINE_MODE=false

# === POST-BETA FAZ 1: Persistent Storage ===
# AILLAME_DATA_DIR=.aillame-data
AILLAME_HEALTH_LIVE_BINDING=true

# === POST-BETA FAZ 2: Security Hardening ===
AILLAME_EXTERNAL_API_AUTH_REQUIRED=false
AILLAME_API_KEY_HASH_SECRET=aillame-default-foundation-secret
AILLAME_RATE_LIMIT_ENABLED=true
AILLAME_RATE_LIMIT_MAX_REQUESTS=60
AILLAME_RATE_LIMIT_WINDOW_MS=60000

# === POST-BETA FAZ 3: E2E Integration ===
AILLAME_EXTERNAL_PROVIDER_BASE_URL=http://localhost:3000
AILLAME_EXTERNAL_PROVIDER_TEST_API_KEY=ail_test_foundation_key

# === POST-BETA FAZ 4: Code Agent Patch Workflow ===
AILLAME_CODE_AGENT_PATCH_APPLY_ENABLED=false
AILLAME_CODE_AGENT_APPROVAL_REQUIRED=true
AILLAME_CODE_AGENT_VERIFIER_EXECUTION_ENABLED=false

# === POST-BETA FAZ 5: Model Discovery & Runtime ===
AILLAME_MODEL_DISCOVERY_ENABLED=true
AILLAME_MODEL_DISCOVERY_OFFLINE_MODE=true
AILLAME_MODEL_WATCHLIST_ENABLED=true
AILLAME_MODEL_DOWNLOADS_ENABLED=false
AILLAME_MODEL_LIBRARY_DIR=./models
AILLAME_GGUF_RUNTIME_ENABLED=false

# === POST-BETA FAZ 6: Nano Evaluation & Training ===
AILLAME_NANO_EVAL_ENABLED=true
AILLAME_NANO_TRAINING_EXPORT_ENABLED=false
AILLAME_NANO_CHECKPOINT_COMPARE_ENABLED=false
AILLAME_NANO_AUTONOMOUS_ACTIONS_ENABLED=false

# === POST-BETA FAZ 7: RAG & Document Library ===
AILLAME_DOCUMENT_LIBRARY_ENABLED=true
AILLAME_DOCUMENT_MAX_CHARS=100000
AILLAME_DOCUMENT_CHUNK_MAX_CHARS=1000
AILLAME_DOCUMENT_CHUNK_OVERLAP=100
AILLAME_DOCUMENT_HARD_DELETE_ENABLED=false
